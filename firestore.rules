rules_version = '2';

// Visitors can only ADD newsletter signups and contact messages; nobody can read those from the website.
// Signed-in players can read, save and delete their own progress (users/{their id}) and nothing else.
// You read everything yourself in the Firebase console (Firestore Database).
service cloud.firestore {
  match /databases/{database}/documents {

    function validEmail(e) {
      return e is string && e.size() <= 200 && e.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
    }

    match /newsletter/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && validEmail(request.resource.data.email)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // A player's saved progress: one small record per game (see SYNC_KEYS in public/assets/js/accounts.js).
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'progress', 'createdAt', 'updatedAt'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 40))
        && (!('progress' in d) || (d.progress is map && d.progress.size() <= 150))
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
