rules_version = '2';

// Visitors can only ADD newsletter signups and contact messages.
// Nobody can read, change or delete anything from the website.
// You read the entries yourself in the Firebase console (Firestore Database).
service cloud.firestore {
  match /databases/{database}/documents {

    function validEmail(e) {
      return e is string && e.size() <= 200 && e.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
    }

    match /newsletter/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && validEmail(request.resource.data.email)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
